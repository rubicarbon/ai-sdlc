{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/rubicarbon/ai-sdlc/main/sdlc.config.schema.json",
  "title": "ai-sdlc project configuration (sdlc.config.json)",
  "description": "Written by /ai-sdlc:sdlc-init and read by every hook, adapter and command of the ai-sdlc plugin. The plugin's scripts/config/validate.sh checks a file against this schema with jq alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "platform", "tier", "commands", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "description": "Config format version." },
    "pluginVersion": { "type": "string", "description": "ai-sdlc version that last rendered this repository; /sdlc-upgrade compares against it." },
    "platform": { "type": "string", "enum": ["github", "azure", "both", "none"], "description": "Where work items and pull requests live. 'none' keeps artifacts local." },
    "tier": { "type": "integer", "minimum": 0, "maximum": 3, "description": "0 foundation, 1 artifacts, 2 guardrails, 3 automation. Each tier requires the ones below it." },
    "repo": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "defaultBranch": { "type": "string", "minLength": 1 }
      }
    },
    "stack": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "language": { "type": "string" },
        "packageManager": { "type": "string" }
      }
    },
    "commands": {
      "type": "object", "additionalProperties": false,
      "required": ["verify"],
      "properties": {
        "verify": { "type": "string", "minLength": 1, "description": "The one command that proves the code works." },
        "format": { "type": "string", "description": "Formatter invoked with the edited file as its last argument." },
        "lint": { "type": "string", "description": "Linter invoked with the edited file as its last argument; non-zero exit is shown to the agent." },
        "deployStaging": { "type": "string" },
        "deployProduction": { "type": "string" }
      }
    },
    "environments": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dev": { "$ref": "#/definitions/environment" },
        "staging": { "$ref": "#/definitions/environment" },
        "prod": { "$ref": "#/definitions/environment" }
      }
    },
    "team": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["solo", "team"] },
        "enablePluginForTeam": { "type": "boolean", "description": "Write enabledPlugins into .claude/settings.json so teammates get ai-sdlc and mattpocock-skills automatically." },
        "codeowners": { "type": "string", "description": "Space-separated GitHub handles or teams that own every path (CODEOWNERS)." },
        "securityOwners": { "type": "string", "description": "Space-separated handles that own the human-only areas (auth, crypto, payments)." }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requiredApprovals": { "type": "integer", "minimum": 1, "maximum": 6 },
        "nitCap": { "type": "integer", "minimum": 0, "maximum": 50 }
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxTurns": { "type": "integer", "minimum": 1, "description": "--max-turns for agent runs in CI." },
        "maxBudgetUsd": { "type": "number", "minimum": 0, "description": "--max-budget-usd per CI run." },
        "alertThresholdUsd": { "type": "number", "minimum": 0, "description": "Weekly spend above which the cost report raises an alert." }
      }
    },
    "guardrails": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requireTicket": { "type": "boolean", "description": "Deny source edits without .sdlc/ACTIVE_TICKET. Defaults to true from tier 2." },
        "protectedPaths": { "type": "array", "items": { "type": "string" } },
        "secretPaths": { "type": "array", "items": { "type": "string" } },
        "testGlobs": { "type": "array", "items": { "type": "string" } },
        "ticketFreePaths": { "type": "array", "items": { "type": "string" }, "description": "Extra globs editable without an active ticket (docs and artifacts already are)." },
        "verifyExtensions": { "type": "array", "items": { "type": "string" }, "description": "File extensions post-edit-verify runs the formatter and linter on." }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": { "type": "string", "minLength": 1, "description": "Where specs, tickets, verification reports, releases, postmortems and metrics accumulate. Default .sdlc" }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "incidentLabel": { "type": "string" },
        "deployEnvironment": { "type": "string" },
        "maxPrs": { "type": "integer", "minimum": 1 }
      }
    },
    "azure": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "organization": { "type": "string", "pattern": "^https://" },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "workItemType": { "type": "string" },
        "requiredReviewers": { "type": "array", "items": { "type": "string" } },
        "pipelineName": { "type": "string" },
        "deployPipelineName": { "type": "string" },
        "deployPipelineId": { "type": "string" }
      }
    },
    "github": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requiredChecks": { "type": "array", "items": { "type": "string" } },
        "deployWorkflow": { "type": "string" }
      }
    },
    "reuse": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mattpocockSkills": { "type": "string", "enum": ["plugin", "editable", "absent"] }
      }
    }
  },
  "definitions": {
    "environment": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gate": { "type": "string", "enum": ["none", "auto", "human"] },
        "approvers": { "type": "array", "items": { "type": "string" } },
        "deployCommandPatterns": { "type": "array", "items": { "type": "string" }, "description": "Shell command globs that gate-production.sh treats as production-affecting." }
      }
    }
  }
}
