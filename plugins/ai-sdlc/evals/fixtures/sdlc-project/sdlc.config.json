{
  "version": 1,
  "platform": "azure",
  "tier": 2,
  "repo": { "owner": "mock-org", "name": "mock-repo", "defaultBranch": "main" },
  "commands": { "verify": "bash verify-mock.sh", "lint": "bash lint-mock.sh" },
