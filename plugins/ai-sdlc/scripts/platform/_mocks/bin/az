#!/usr/bin/env bash
# Mock Azure CLI for conformance tests and --dry-run. Answers the subset of `az`
# the Azure adapter uses, keeps state under $SDLC_MOCK_STATE, logs every call.
#
# Knobs (environment):
#   SDLC_MOCK_CHECKS=pass|fail|pending|empty|skipped   what `repos pr policy list` reports
#   SDLC_MOCK_PR_REVIEWERS='[{"vote":10,"uniqueName":"a@x"}]'  reviewers of `repos pr show`
#   SDLC_MOCK_PR_HEAD_SHA=<40 hex>            lastMergeSourceCommit reported by `repos pr show`
#   SDLC_MOCK_FAIL="<subcommand prefix>"      e.g. "repos pr list": print an error, exit 1
#   SDLC_MOCK_MALFORMED="<subcommand prefix>" print "{not json" and exit 0
#   SDLC_MOCK_EMPTY="<subcommand prefix>"     print [] (or {"value":[]} for `rest`), exit 0
# `repos policy <kind> create|update` store the settings and scope they were given under
# $SDLC_MOCK_STATE/policies.json, `repos policy delete --id` removes one, and
# `repos policy list` returns every stored policy (no branch filtering: the adapter must
# filter by scope itself).
set -u
S="${SDLC_MOCK_STATE:-${TMPDIR:-/tmp}/ai-sdlc-mock-state}"; mkdir -p "$S"
[ -n "${SDLC_MOCK_LOG:-}" ] && printf 'az %s\n' "$*" >>"$SDLC_MOCK_LOG"
ORG="https://dev.azure.com/mock-org"; PROJ="mock-proj"; REPO="mock-repo"; REPO_ID="11111111-2222-3333-4444-555555555555"
all="$*"
if [ -n "${SDLC_MOCK_FAIL:-}" ] && [[ "$all" == "$SDLC_MOCK_FAIL"* ]]; then
  echo "ERROR: simulated failure of 'az $SDLC_MOCK_FAIL' (TF400813: the request was not authorized)" >&2; exit 1
fi
if [ -n "${SDLC_MOCK_MALFORMED:-}" ] && [[ "$all" == "$SDLC_MOCK_MALFORMED"* ]]; then echo "{not json"; exit 0; fi
if [ -n "${SDLC_MOCK_EMPTY:-}" ] && [[ "$all" == "$SDLC_MOCK_EMPTY"* ]]; then
  case "$all" in rest*) echo '{"value":[]}' ;; *) echo '[]' ;; esac; exit 0
fi
next_id() { local f="$S/$1.counter" n=0; [ -f "$f" ] && n=$(<"$f"); n=$((n+1)); echo "$n" >"$f"; echo "$n"; }
arg_after() { local k="$1"; shift; while [ $# -gt 0 ]; do if [ "$1" = "$k" ]; then echo "${2:-}"; return; fi; shift; done; }
query=$(arg_after --query "$@"); output=$(arg_after -o "$@"); [ -z "$output" ] && output=$(arg_after --output "$@")
emit() {  # apply --query (subset: dotted path) and -o tsv when asked
  local json="$1"
  if [ -n "$query" ]; then
    case "$query" in
      \[?*) json=$(echo "$json" | jq -c '.') ;;                  # JMESPath filters: return everything
      *) json=$(echo "$json" | jq -c ".$query" 2>/dev/null || echo "$json") ;;
    esac
  fi
  if [ "$output" = "tsv" ]; then echo "$json" | jq -r 'if type=="array" then .[]|tostring else tostring end'; else echo "$json"; fi
}

# policy_type <kind> -> POLICY_TYPE_ID, POLICY_TYPE_NAME (well-known Azure DevOps ids)
policy_type() {
  case "$1" in
    approver-count)    POLICY_TYPE_ID=fa4e907d-c16b-4a4c-9dfa-4906e5d171dd; POLICY_TYPE_NAME="Minimum number of reviewers" ;;
    required-reviewer) POLICY_TYPE_ID=fd2167ab-b0be-447a-8ec8-39368250530e; POLICY_TYPE_NAME="Required reviewers" ;;
    build)             POLICY_TYPE_ID=0609b952-1397-4640-95ec-e00a01b2c241; POLICY_TYPE_NAME="Build" ;;
    work-item-linking) POLICY_TYPE_ID=40e92b44-2fe1-4dd6-b3d8-74a9c21d0c6e; POLICY_TYPE_NAME="Work item linking" ;;
    comment-required)  POLICY_TYPE_ID=c6a1889d-b943-4856-b76f-9e46bb6b0df2; POLICY_TYPE_NAME="Comment requirements" ;;
    merge-strategy)    POLICY_TYPE_ID=fa4e907d-c16b-4a4c-9dfa-4906e5d171de; POLICY_TYPE_NAME="Require a merge strategy" ;;
    *)                 POLICY_TYPE_ID="mock-$1"; POLICY_TYPE_NAME="$1" ;;
  esac
}
# policy_from_args <args...> -> JSON {isEnabled,isBlocking,settings,branch,repositoryId}
# parsed from the flags the adapter passes to `repos policy <kind> create|update`.
policy_from_args() {
  local -a a=("$@"); local i=0 k v obj='{"isEnabled":true,"isBlocking":true,"settings":{},"branch":"main"}'
  obj=$(printf '%s' "$obj" | jq -c --arg r "$REPO_ID" '.repositoryId=$r')
  bool() { case "${1,,}" in true|1|yes) echo true ;; *) echo false ;; esac; }
  num() { case "$1" in ''|*[!0-9]*) printf '"%s"' "$1" ;; *) printf '%s' "$1" ;; esac; }
  while [ $i -lt ${#a[@]} ]; do
    k="${a[$i]}"; v="${a[$((i+1))]:-}"
    case "$k" in
      --minimum-approver-count) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(num "$v")" '.settings.minimumApproverCount=$v') ;;
      --creator-vote-counts) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(bool "$v")" '.settings.creatorVoteCounts=$v') ;;
      --allow-downvotes) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(bool "$v")" '.settings.allowDownvotes=$v') ;;
      --reset-on-source-push) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(bool "$v")" '.settings.resetOnSourcePush=$v') ;;
      --required-reviewer-ids) obj=$(printf '%s' "$obj" | jq -c --arg v "$v" '.settings.requiredReviewerIds=($v|split(";")|map(select(length>0)))') ;;
      --message) obj=$(printf '%s' "$obj" | jq -c --arg v "$v" '.settings.message=$v') ;;
      --build-definition-id) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(num "$v")" '.settings.buildDefinitionId=$v') ;;
      --display-name) obj=$(printf '%s' "$obj" | jq -c --arg v "$v" '.settings.displayName=$v') ;;
      --manual-queue-only) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(bool "$v")" '.settings.manualQueueOnly=$v') ;;
      --queue-on-source-update-only) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(bool "$v")" '.settings.queueOnSourceUpdateOnly=$v') ;;
      --valid-duration) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(num "$v")" '.settings.validDuration=$v') ;;
      --blocking) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(bool "$v")" '.isBlocking=$v') ;;
      --enabled) obj=$(printf '%s' "$obj" | jq -c --argjson v "$(bool "$v")" '.isEnabled=$v') ;;
      --branch) obj=$(printf '%s' "$obj" | jq -c --arg v "$v" '.branch=$v') ;;
      --repository-id) obj=$(printf '%s' "$obj" | jq -c --arg v "$v" '.repositoryId=$v') ;;
    esac
    i=$((i+1))
  done
  printf '%s' "$obj"
}

case "${1:-} ${2:-} ${3:-}" in
  "account show "*) emit '{"user":{"name":"mock@example.com"},"tenantId":"t"}'; exit 0 ;;
  "extension show "*) emit '{"name":"azure-devops","version":"1.0.0"}'; exit 0 ;;
  "devops configure "*) echo "[defaults]"; echo "organization = $ORG"; echo "project = $PROJ"; exit 0 ;;
  "devops project show") emit '{"id":"p1","name":"mock-proj","capabilities":{"processTemplate":{"templateName":"Agile"}}}'; exit 0 ;;
  "boards work-item "*)
    case "$3 ${4:-}" in
      "create "*)
        n=$(next_id wi); title=$(arg_after --title "$@"); type=$(arg_after --type "$@"); desc=$(arg_after --description "$@")
        tags=$(arg_after --fields "$@"); tags="${tags#System.Tags=}"
        jq -cn --arg n "$n" --arg t "$title" --arg ty "$type" --arg d "$desc" --arg tags "$tags" '{id:($n|tonumber),rev:1,url:("https://dev.azure.com/mock-org/_apis/wit/workItems/"+$n),fields:{"System.Title":$t,"System.WorkItemType":$ty,"System.State":"New","System.Description":$d,"System.Tags":$tags,"System.CreatedDate":"2026-09-01T10:00:00Z","System.AssignedTo":null},_links:{html:{href:("https://dev.azure.com/mock-org/mock-proj/_workitems/edit/"+$n)}},relations:[]}' >"$S/wi-$n.json"
        emit "$(cat "$S/wi-$n.json")"; exit 0 ;;
      "show "*)
        n=$(arg_after --id "$@"); f="$S/wi-$n.json"
        [ -f "$f" ] || jq -cn --arg n "$n" '{id:($n|tonumber),rev:1,url:("https://dev.azure.com/mock-org/_apis/wit/workItems/"+$n),fields:{"System.Title":("Work item "+$n),"System.WorkItemType":"User Story","System.State":"Active","System.Description":("<p>Body of work item "+$n+"</p>"),"System.Tags":"ready-for-agent","System.CreatedDate":"2026-09-01T10:00:00Z","System.AssignedTo":{"uniqueName":"dev@example.com"}},_links:{html:{href:("https://dev.azure.com/mock-org/mock-proj/_workitems/edit/"+$n)}},relations:[]}' >"$f"
        emit "$(cat "$f")"; exit 0 ;;
      "update "*)
        n=$(arg_after --id "$@"); f="$S/wi-$n.json"; [ -f "$f" ] || az boards work-item show --id "$n" >/dev/null
        c=$(next_id wicomment); jq -c --arg c "$c" '.rev+=1 | .lastComment=$c' "$f" >"$f.tmp" && mv "$f.tmp" "$f"; emit "$(cat "$f")"; exit 0 ;;
      "relation add")
        a=$(arg_after --id "$@"); t=$(arg_after --relation-type "$@"); b=$(arg_after --target-id "$@")
        key="$a|${t,,}|$b"
        if [ -f "$S/relations.log" ] && grep -qxF "$key" "$S/relations.log"; then
          echo "TF201036: You cannot add a $t link between work items $a and $b because a link of that type already exists." >&2; exit 1
        fi
        echo "$key" >>"$S/relations.log"
        jq -cn --arg a "$a" --arg t "$t" --arg b "$b" '{id:($a|tonumber),relations:[{rel:$t,url:("https://dev.azure.com/mock-org/_apis/wit/workItems/"+$b)}]}'; exit 0 ;;
      "relation list-type")
        emit '[{"referenceName":"System.LinkTypes.Dependency-Forward","name":"Successor"},{"referenceName":"System.LinkTypes.Dependency-Reverse","name":"Predecessor"},{"referenceName":"System.LinkTypes.Hierarchy-Forward","name":"Child"},{"referenceName":"System.LinkTypes.Hierarchy-Reverse","name":"Parent"},{"referenceName":"System.LinkTypes.Related","name":"Related"}]'; exit 0 ;;
    esac ;;
  "boards query "*)
    emit '[{"id":301,"fields":{"System.Id":301,"System.CreatedDate":"2026-08-03T09:00:00Z","Microsoft.VSTS.Common.ClosedDate":"2026-08-03T15:30:00Z","System.Tags":"incident"}},{"id":305,"fields":{"System.Id":305,"System.CreatedDate":"2026-08-20T09:00:00Z","Microsoft.VSTS.Common.ClosedDate":null,"System.Tags":"incident"}}]'; exit 0 ;;
  "repos show "*) emit "{\"id\":\"$REPO_ID\",\"name\":\"$REPO\",\"webUrl\":\"$ORG/$PROJ/_git/$REPO\",\"defaultBranch\":\"refs/heads/main\"}"; exit 0 ;;
  "repos pr create")
    n=$(next_id pr); title=$(arg_after --title "$@"); src=$(arg_after --source-branch "$@"); tgt=$(arg_after --target-branch "$@")
    jq -cn --arg n "$n" --arg t "$title" --arg s "$src" --arg g "$tgt" --arg w "$ORG/$PROJ/_git/$REPO" '{pullRequestId:($n|tonumber),title:$t,status:"active",sourceRefName:("refs/heads/"+$s),targetRefName:("refs/heads/"+$g),creationDate:"2026-09-01T10:00:00Z",closedDate:null,createdBy:{uniqueName:"mock@example.com"},repository:{webUrl:$w},reviewers:[]}'; exit 0 ;;
  "repos pr show")
    n=$(arg_after --id "$@")
    reviewers='[{"vote":0,"uniqueName":"lead@example.com","displayName":"Lead","id":"r-lead"}]'
    if [ -n "${SDLC_MOCK_PR_REVIEWERS:-}" ]; then reviewers="$SDLC_MOCK_PR_REVIEWERS"; fi
    head_sha="${SDLC_MOCK_PR_HEAD_SHA:-1111111111111111111111111111111111111111}"
    emit "$(jq -cn --arg n "$n" --arg w "$ORG/$PROJ/_git/$REPO" --arg h "$head_sha" --argjson r "$reviewers" '{pullRequestId:($n|tonumber),title:("PR "+$n),description:("Body of PR "+$n+" (AB#12)"),status:"active",sourceRefName:"refs/heads/feature/x",targetRefName:"refs/heads/main",creationDate:"2026-09-01T10:00:00Z",closedDate:null,createdBy:{uniqueName:"mock@example.com",displayName:"Mock User",id:"u-mock"},repository:{webUrl:$w,remoteUrl:$w},reviewers:$r,lastMergeSourceCommit:{commitId:$h},lastMergeTargetCommit:{commitId:"2222222222222222222222222222222222222222"}}')"; exit 0 ;;
  "repos pr policy")
    # Evaluations of the PR's branch policies; the build policy is named after the pipeline.
    case "${SDLC_MOCK_CHECKS:-pass}" in
      fail) emit '[{"configuration":{"type":{"displayName":"Build"},"settings":{"displayName":"sdlc-pr-review"}},"status":"rejected","context":{"buildId":77}},{"configuration":{"type":{"displayName":"Minimum number of reviewers"}},"status":"approved"}]' ;;
      pending) emit '[{"configuration":{"type":{"displayName":"Build"},"settings":{"displayName":"sdlc-pr-review"}},"status":"running"}]' ;;
      empty) emit '[]' ;;
      skipped) emit '[{"configuration":{"type":{"displayName":"Build"},"settings":{"displayName":"sdlc-pr-review"}},"status":"notApplicable"},{"configuration":{"type":{"displayName":"Minimum number of reviewers"}},"status":"notApplicable"}]' ;;
      *) emit '[{"configuration":{"type":{"displayName":"Build"},"settings":{"displayName":"sdlc-pr-review"}},"status":"approved","context":{"buildId":77}},{"configuration":{"type":{"displayName":"Minimum number of reviewers"}},"status":"approved"}]' ;;
    esac; exit 0 ;;
  "repos pr list")
    emit "$(jq -cn --arg w "$ORG/$PROJ/_git/$REPO" '[{pullRequestId:70,title:"Add thing",status:"completed",creationDate:"2026-08-01T09:00:00Z",closedDate:"2026-08-02T12:00:00Z",createdBy:{uniqueName:"dev-a@example.com"},lastMergeSourceCommit:{commitId:"aaa111"},lastMergeTargetCommit:{commitId:"000000"},repository:{webUrl:$w}},{pullRequestId:71,title:"Revert \"Add thing\"",status:"completed",creationDate:"2026-08-03T09:00:00Z",closedDate:"2026-08-03T10:00:00Z",createdBy:{uniqueName:"dev-b@example.com"},lastMergeSourceCommit:{commitId:"bbb222"},lastMergeTargetCommit:{commitId:"aaa111"},repository:{webUrl:$w}}]')"; exit 0 ;;
  "repos policy list")
    if [ -f "$S/policies.json" ]; then cat "$S/policies.json"; else echo '[]'; fi; exit 0 ;;
  "repos policy delete")
    n=$(arg_after --id "$@"); [ -f "$S/policies.json" ] || echo '[]' >"$S/policies.json"
    jq -e --arg n "$n" 'any(.[]; .id == ($n|tonumber))' "$S/policies.json" >/dev/null \
      || { echo "ERROR: policy configuration $n does not exist" >&2; exit 1; }
    jq -c --arg n "$n" 'map(select(.id != ($n|tonumber)))' "$S/policies.json" >"$S/policies.json.tmp" && mv "$S/policies.json.tmp" "$S/policies.json"
    exit 0 ;;
  "repos policy "*)
    kind="$3"; action="${4:-}"
    policy_type "$kind"
    [ -f "$S/policies.json" ] || echo '[]' >"$S/policies.json"
    given=$(policy_from_args "$@")
    case "$action" in
      create)
        n=$(next_id policy)
        jq -c --arg n "$n" --arg tid "$POLICY_TYPE_ID" --arg dn "$POLICY_TYPE_NAME" --argjson g "$given" '. + [{
          id:($n|tonumber), isEnabled:$g.isEnabled, isBlocking:$g.isBlocking, type:{id:$tid, displayName:$dn},
          settings:($g.settings + {scope:[{refName:("refs/heads/"+$g.branch), matchKind:"Exact", repositoryId:$g.repositoryId}]})}]' \
          "$S/policies.json" >"$S/policies.json.tmp" && mv "$S/policies.json.tmp" "$S/policies.json"
        jq -c --arg n "$n" '.[] | select(.id == ($n|tonumber))' "$S/policies.json"; exit 0 ;;
      update)
        n=$(arg_after --id "$@")
        jq -e --arg n "$n" 'any(.[]; .id == ($n|tonumber))' "$S/policies.json" >/dev/null \
          || { echo "ERROR: policy configuration $n does not exist" >&2; exit 1; }
        jq -c --arg n "$n" --argjson g "$given" 'map(if .id == ($n|tonumber) then
          .isEnabled=$g.isEnabled | .isBlocking=$g.isBlocking
          | .settings=(.settings + $g.settings + {scope:[{refName:("refs/heads/"+$g.branch), matchKind:"Exact", repositoryId:$g.repositoryId}]})
          else . end)' "$S/policies.json" >"$S/policies.json.tmp" && mv "$S/policies.json.tmp" "$S/policies.json"
        jq -c --arg n "$n" '.[] | select(.id == ($n|tonumber))' "$S/policies.json"; exit 0 ;;
    esac ;;
  "pipelines list "*)
    name=$(arg_after --name "$@")
    if [ -n "$name" ] && [ -f "$S/pipeline-$name" ]; then cat "$S/pipeline-$name"; else echo '[]'; fi; exit 0 ;;
  "pipelines create "*)
    n=$(next_id pipeline); name=$(arg_after --name "$@")
    jq -cn --arg n "$n" --arg name "$name" '[{id:($n|tonumber),name:$name}]' >"$S/pipeline-$name"; jq -c '.[0]' "$S/pipeline-$name"; exit 0 ;;
  "pipelines runs list")
    emit '[{"id":501,"result":"succeeded","queueTime":"2026-08-02T12:05:00Z","finishTime":"2026-08-02T12:15:00Z","sourceVersion":"aaa111"},{"id":502,"result":"failed","queueTime":"2026-08-03T10:05:00Z","finishTime":"2026-08-03T10:09:00Z","sourceVersion":"bbb222"}]'; exit 0 ;;
  "rest "*)
    method=$(arg_after --method "$@"); uri=$(arg_after --uri "$@")
    case "${method,,} $uri" in
      "post "*/threads*) c=$(next_id thread); jq -cn --arg c "$c" '{id:($c|tonumber),status:"active"}'; exit 0 ;;
      "get "*/threads*) emit '{"value":[{"id":1,"publishedDate":"2026-08-01T15:00:00Z","properties":{"CodeReviewVoteResult":{"$value":"10"}}},{"id":2,"publishedDate":"2026-08-01T11:00:00Z","properties":{}}]}'; exit 0 ;;
    esac ;;
esac
echo "mock az: unhandled command: $*" >&2; exit 1
