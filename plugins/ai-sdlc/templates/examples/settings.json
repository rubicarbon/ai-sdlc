{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.env.*.local)",
      "Read(secrets/**)",
      "Read(**/*-key.pem)",
      "Read(**/*.key.pem)",
      "Read(**/privkey.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.azure/**)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.staging)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "Edit(.env.*.local)",
      "Edit(secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)"
    ]
  },
  "extraKnownMarketplaces": {
    "ai-sdlc-kit": {
      "source": {
        "source": "github",
        "repo": "rubicarbon/ai-sdlc"
      }
    }
  },
  "enabledPlugins": {
    "ai-sdlc@ai-sdlc-kit": true,
    "mattpocock-skills@claude-plugins-official": true
  }
}
