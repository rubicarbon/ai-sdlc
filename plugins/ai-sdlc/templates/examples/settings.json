{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.env.*.local)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.azure/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(secrets/**)",
      "Edit(sdlc.config.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)"
    ]
  },
  "extraKnownMarketplaces": {
    "ai-sdlc-kit": {
      "source": {
        "source": "github",
        "repo": "rubicarbon/ai-sdlc"
      }
    }
  },
  "enabledPlugins": {
    "ai-sdlc@ai-sdlc-kit": true,
    "mattpocock-skills@claude-plugins-official": true
  }
}
