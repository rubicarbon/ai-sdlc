{
  "$schema": "https://raw.githubusercontent.com/rubicarbon/ai-sdlc/main/sdlc.config.schema.json",
  "version": 1,
  "pluginVersion": "0.1.0",
  "platform": "azure",
  "tier": 2,
  "repo": {
    "owner": "contoso",
    "name": "usage-digest",
    "defaultBranch": "main"
  },
  "stack": {
    "language": "typescript",
    "packageManager": "pnpm"
  },
  "commands": {
    "verify": "pnpm verify",
    "verifySetup": "pnpm install --frozen-lockfile",
    "format": "pnpm prettier --write",
    "lint": "pnpm eslint",
    "deployStaging": "pnpm run deploy:staging",
    "deployProduction": "pnpm run deploy:production"
  },
  "environments": {
    "dev": { "gate": "none" },
    "staging": { "gate": "auto" },
    "prod": { "gate": "human", "approvers": ["release-managers"], "deployCommandPatterns": ["git push * main", "pnpm run deploy:production", "pnpm run deploy:production*"] }
  },
  "team": {
    "mode": "team",
    "enablePluginForTeam": true,
    "codeowners": "@contoso/platform-leads",
    "securityOwners": "@contoso/security @contoso/platform-leads"
  },
  "review": {
    "requiredApprovals": 1,
    "nitCap": 5
  },
  "cost": {
    "maxTurns": 40,
    "maxBudgetUsd": 5,
    "alertThresholdUsd": 25
  },
  "guardrails": {
    "protectedPaths": [".azuredevops/**"],
    "secretPaths": [".env", ".env.*", "secrets/**", "**/*.key", "**/*-key.pem"]
  },
  "artifacts": {
    "dir": ".sdlc"
  },
  "metrics": {
    "incidentLabel": "incident",
    "deployEnvironment": "production",
    "maxPrs": 200
  },
  "azure": {
    "organization": "https://dev.azure.com/contoso",
    "project": "Platform",
    "repo": "usage-digest",
    "workItemType": "User Story",
    "requiredReviewers": ["lead@contoso.com"],
    "pipelineName": "sdlc-pr-review",
    "deployPipelineName": "sdlc-deploy"
  },
  "github": {
    "requiredChecks": ["sdlc-pr-review"],
    "deployWorkflow": "sdlc-deploy.yml"
  },
  "reuse": {
    "mattpocockSkills": "plugin"
  }
}
